# Copy to .env and fill in. .env is gitignored; this file is not — never put
# real secrets here.

# --- Deployment (used by docker-compose.yml, not by app code) ---------------
# Machine A's LAN address. Container ports bind to this, not 0.0.0.0.
LAN_IP=192.168.1.10

# --- Postgres (already running on machine A as the pgvector-db container) ---
PGVECTOR_HOST=127.0.0.1
PGVECTOR_PORT=5433
PGVECTOR_DATABASE=line
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=
PGVECTOR_POOL_MIN_SIZE=2
PGVECTOR_POOL_MAX_SIZE=10

# --- Ollama (already running on machine A) ---------------------------------
AI_API=http://localhost:11434
CHAT_MODEL=qwen3.5:9b
EMBEDDING_MODEL=qwen3-embedding:4b

# --- RabbitMQ --------------------------------------------------------------
# The broker runs on machine B (e.g. 192.168.1.20) — see
# deploy/rabbitmq/docker-compose.yml. Reach it by LAN address, never by the
# public DDNS name, and do not port-forward 5672 on the router.
#
# Must not be the `guest` account: RabbitMQ refuses guest on any non-loopback
# connection, and machine A connecting to machine B is very much not loopback.
RABBITMQ_URL=amqp://linelog:<rabbitmq-password>@<machine-b-lan-ip>:5672/
ISSUE_QUEUE_NAME=line.issue

# --- LINE Messaging API ----------------------------------------------------
# Console > your channel > Basic settings > Channel secret
LINE_CHANNEL_SECRET=
# Console > your channel > Messaging API > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# --- GitHub ----------------------------------------------------------------
# Fine-grained PAT scoped to the one repo. Needs Issues: Read and write, and
# — if ATTACH_FILES_TO_ISSUES is on — Contents: Read and write as well, since
# captured images/files are uploaded as assets on a release.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_LABELS=needs-triage

# Optional per-reporter override: files the issue under that person's own
# GitHub account instead of GITHUB_TOKEN. Keyed by their LINE display name
# (exact match, case-sensitive). Anyone not listed falls back to GITHUB_TOKEN.
# Format: "Display Name:token,Other Name:token"
GITHUB_USER_TOKENS=

# GitHub has no API for issue attachments, so captured files are uploaded as
# assets on this one long-lived release and linked from the issue body. Set
# false to keep filing issues without the extra token scope (files are still
# captured to disk either way).
ATTACH_FILES_TO_ISSUES=true
GITHUB_ASSETS_TAG=line-attachments
GITHUB_ASSET_MAX_BYTES=26214400
MAX_ATTACHMENTS_PER_ISSUE=20

# --- Runtime ---------------------------------------------------------------
MEDIA_ROOT=./data/media
STALE_CLAIM_MINUTES=10
# Publicly reachable origin in front of this app (nginx/DDNS), used to build
# attachment preview URLs GitHub can fetch and inline-render. No trailing slash.
PUBLIC_BASE_URL=https://your-domain.example.com

# --- Capture sessions ("ai start" ... "ai end") ----------------------------
CAPTURE_SESSION_TTL_MINUTES=120
MAX_CAPTURE_MESSAGES=200
ATTACHMENT_WAIT_S=20
